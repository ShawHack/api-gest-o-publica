+.empty { padding: 36px; border: 1px dashed #cbd1df; border-radius: 14px; text-align: center; color: #697389; background: white; }
+.error, .success { margin-bottom: 18px; padding: 13px 16px; border-radius: 10px; }.error { color: #992c35; background: #ffeded; border: 1px solid #efb8bc; }.success { color: #276c41; background: #eaf7ee; border: 1px solid #b5dbc1; }
+.editor { display: grid; gap: 18px; padding: 24px; border: 1px solid #e0e4ee; border-radius: 16px; background: white; }.grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }.editor label, .fieldRow label { display: grid; gap: 7px; color: #34405a; font-weight: 700; }.editor input, .editor select, .editor textarea, .fieldRow input, .fieldRow select, .fieldRow textarea { width: 100%; box-sizing: border-box; border: 1px solid #cbd1df; border-radius: 8px; padding: 11px; background: white; color: #26334f; font: inherit; }.editor textarea { min-height: 90px; resize: vertical; }.fields { display: grid; gap: 12px; }.fieldRow { display: grid; grid-template-columns: 2fr 1fr auto auto; align-items: end; gap: 12px; padding: 16px; border: 1px solid #e2e6ef; border-radius: 12px; background: #f8f9fc; }.fieldRow .check { display: flex; align-items: center; gap: 7px; padding-bottom: 11px; white-space: nowrap; }.fieldRow .check input { width: auto; }.fieldRow .wide { grid-column: 1 / -1; }
