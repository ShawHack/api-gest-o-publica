# build
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json ./
RUN npm install
COPY . .
ARG VITE_NOVOSGA_API_URL=
ARG VITE_MERCURE_PUBLIC_URL=
ARG VITE_MERCURE_TOPIC_TEMPLATE=/unidades/{unitId}/painel
ARG VITE_MERCURE_SUBSCRIBE_GLOBAL=true
ARG VITE_MERCURE_SUBSCRIBER_JWT=
ARG VITE_DISPLAY_MODE=production
ARG VITE_ENABLE_DEMO=false
ARG VITE_DEFAULT_UNIT_ID=
ARG VITE_POLL_INTERVAL_MS=8000
ENV VITE_NOVOSGA_API_URL=$VITE_NOVOSGA_API_URL \
    VITE_MERCURE_PUBLIC_URL=$VITE_MERCURE_PUBLIC_URL \
    VITE_MERCURE_TOPIC_TEMPLATE=$VITE_MERCURE_TOPIC_TEMPLATE \
    VITE_MERCURE_SUBSCRIBE_GLOBAL=$VITE_MERCURE_SUBSCRIBE_GLOBAL \
    VITE_MERCURE_SUBSCRIBER_JWT=$VITE_MERCURE_SUBSCRIBER_JWT \
    VITE_DISPLAY_MODE=$VITE_DISPLAY_MODE \
    VITE_ENABLE_DEMO=$VITE_ENABLE_DEMO \
    VITE_DEFAULT_UNIT_ID=$VITE_DEFAULT_UNIT_ID \
    VITE_POLL_INTERVAL_MS=$VITE_POLL_INTERVAL_MS
RUN npm run build

# runtime
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=80
ENV DATA_DIR=/data
RUN apk add --no-cache wget
COPY --from=build /app/node_modules ./node_modules
COPY server ./server
COPY --from=build /app/dist ./dist
RUN mkdir -p /data
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz || exit 1
EXPOSE 80
CMD ["node", "server/index.mjs"]
