PORT=5000
NODE_ENV=development
JWT_SECRET=gerar-string-aleatoria-minimo-32-chars
# Memorial: access curto + refresh (opcional; padrão 15m / 7 dias)
# MEMORIAL_ACCESS_TTL=15m
# MEMORIAL_REFRESH_DAYS=7
MONGODB_URI=mongodb://127.0.0.1:27019/apicemiterio
RATE_LIMIT_MAX=0
TRUST_PROXY=1
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost

# Produção: RATE_LIMIT_MAX=300
# Alertas uptime (cron scripts/uptime-check.sh — e-mail quando falha)
# UPTIME_ALERT_EMAIL_TO=cgp@garca.sp.gov.br
# UPTIME_ALERT_COOLDOWN_MIN=30

# LGPD / observabilidade (opcional)
# Retenção audit por tier (mín. 30 dias cada)
# AUDIT_LOG_RETENTION_DAYS=365
# AUDIT_LOG_RETENTION_SECURITY_DAYS=1825
# AUDIT_LOG_RETENTION_LGPD_DAYS=1825
# AUDIT_LOG_RETENTION_DENIED_DAYS=730
# AUDIT_LOG_RETENTION_VIEW_DAYS=90
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05
# API_KEYS=chave1,chave2
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
