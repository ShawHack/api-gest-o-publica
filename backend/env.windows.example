# ============================================
# Configuração da API para Windows
# ============================================
# Copie este arquivo para .env e ajuste os valores

# Porta da API
PORT=5000

# MongoDB
# Para instalação local padrão do MongoDB no Windows:
MONGODB_URI=mongodb://localhost:27017/apicemiterio

# Para MongoDB em outro servidor:
# MONGODB_URI=mongodb://usuario:senha@servidor:27017/apicemiterio?authSource=admin

# Diretório de uploads (Windows)
# Use barras normais ou duplas invertidas
UPLOAD_DIR=C:\api-semit\uploads

# Ambiente
NODE_ENV=production
# NODE_ENV=development

# CORS - Origens permitidas (separadas por vírgula)
# Ajuste com o domínio do seu servidor
CORS_ORIGIN=https://api.garca.sp.gov.br,http://localhost:3000

# CORS - Padrões regex para localhost (separados por vírgula)
CORS_ORIGIN_REGEX=^https?://localhost:\d+$

# Trust Proxy (1 = sim, 0 = não)
# Use 1 se estiver atrás de um proxy reverso (Nginx, IIS)
TRUST_PROXY=1

# JWT Secret (GERE UM NOVO OU USE O MESMO DO SERVIDOR LINUX)
# Para gerar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=seu_jwt_secret_aqui_altere_este_valor

# API Keys para integrações externas (separadas por vírgula)
# Header: X-API-Key: <chave>
# API_KEYS=chave1,chave2,chave3

# (Opcional) ID do usuário associado à API Key - operações usarão este usuário
# API_KEY_USER_ID=64f1234567890abcdef

# ============================================
# Configuração de Email (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app

# ============================================
# Configurações Opcionais
# ============================================
# Timeout de conexão MongoDB (ms)
# MONGO_CONNECTION_TIMEOUT=10000

# Tamanho máximo de upload (bytes)
# MAX_UPLOAD_SIZE=10485760


